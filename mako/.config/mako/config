# =============================================================
#  mako — notificações
#  Clique na notificação para fechar. Super + N limpa todas.
# =============================================================

font=JetBrainsMono Nerd Font 11
anchor=top-right
margin=10
padding=12
width=360
border-size=2
border-radius=12
max-icon-size=48
default-timeout=6000

# Cores: as do álbum tocando (cores, gerado pelo tema musical) ou as do Muzan
# (cores-muzan) quando não há álbum
include=~/.config/mako/cores

[urgency=high]
default-timeout=0
