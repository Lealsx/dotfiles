// =============================================================
//  Waybar — a barra do topo
// =============================================================
//  Esquerda: menu, áreas de trabalho, janela atual
//  Centro:   relógio (clique = calendário) + Spotify + outros players (YouTube...)
//  Direita:  teclado, volume, brilho, rede, bateria, ícones, energia
//  Doc: https://github.com/Alexays/Waybar/wiki
// =============================================================
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 6,

    "modules-left":   ["custom/menu", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock", "group/spotify", "mpris"],
    "modules-right":  ["hyprland/language", "pulseaudio", "backlight", "network", "custom/economia", "battery", "tray", "custom/energia"],

    // Botão que abre o menu de aplicativos
    "custom/menu": {
        "format": "\uf303",
        "tooltip-format": "Aplicativos (Super + D)",
        "on-click": "rofi -show drun"
    },

    // Áreas de trabalho: clique para ir, rolar para passar
    "hyprland/workspaces": {
        "format": "{id}",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    // Título da janela com foco
    "hyprland/window": {
        "max-length": 50,
        "separate-outputs": true
    },

    "clock": {
        "locale": "pt_BR.UTF-8",
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %d de %B  %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#cba6f7'><b>{}</b></span>",
                "today":  "<span color='#89b4fa'><b><u>{}</u></b></span>"
            }
        }
    },

    // ---------- Spotify ----------
    // Um "grupo" junta vários módulos numa pílula só:
    // [ícone + música] [anterior] [tocar/pausar] [próxima]
    "group/spotify": {
        "orientation": "horizontal",
        "modules": ["custom/spotify", "custom/visualizador", "custom/spotify-anterior", "custom/spotify-play", "custom/spotify-proxima"]
    },

    // Música atual. Clique = abrir/mostrar o Spotify | rolar = próxima/anterior
    "custom/spotify": {
        "exec": "~/.config/hypr/scripts/spotify.sh status",
        "return-type": "json",
        "format": "\uf1bc  {}",
        "on-click": "~/.config/hypr/scripts/spotify.sh abrir",
        "on-scroll-up": "playerctl --player=spotify next",
        "on-scroll-down": "playerctl --player=spotify previous",
        "escape": false
    },
    // Barrinhas que dançam no ritmo da música (cava). Somem quando não há som.
    "custom/visualizador": {
        "exec": "~/.config/hypr/scripts/visualizador.sh",
        "format": "{}",
        "tooltip": false
    },
    "custom/spotify-anterior": {
        "format": "\uf048",
        "tooltip-format": "Música anterior",
        "on-click": "playerctl --player=spotify previous"
    },
    "custom/spotify-play": {
        "format": "\uf04b \uf04c",
        "tooltip-format": "Tocar/pausar",
        "on-click": "playerctl --player=spotify play-pause"
    },
    "custom/spotify-proxima": {
        "format": "\uf051",
        "tooltip-format": "Próxima música",
        "on-click": "playerctl --player=spotify next"
    },

    // Música/vídeo tocando agora (Spotify, YouTube no Brave, VLC...)
    // O Spotify tem o próprio módulo acima, então aqui ele é ignorado.
    // Só aparece quando tem algo tocando.
    // Clique = tocar/pausar | botão do meio = anterior | botão direito = próxima
    // Rolar = próxima/anterior
    "mpris": {
        "format": "{player_icon}  {dynamic}",
        "format-paused": "{status_icon}  <i>{dynamic}</i>",
        "dynamic-order": ["title", "artist"],
        "dynamic-separator": " · ",
        "dynamic-len": 45,
        "ignored-players": ["spotify"],
        "player-icons": {
            "default": "\uf001",
            "spotify": "\uf1bc",
            "brave": "\uf144",
            "chromium": "\uf144"
        },
        "status-icons": { "paused": "\uf04c" },
        "tooltip-format": "{player}: {title}\n{artist} — {album}",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    // Teclado atual: clique para trocar (o mesmo que Super + Espaço)
    "hyprland/language": {
        "format": "󰌌 {}",
        "format-en": "US",
        "format-pt": "BR",
        "on-click": "hyprctl switchxkblayout all next"
    },

    // Volume: clique = mudo | botão direito = controle de som | rolar = volume
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 mudo",
        "format-icons": { "headphone": "\uf025", "default": ["\uf026", "\uf027", "\uf028"] },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "scroll-step": 5
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    // Rede: clique = configurações de rede
    "network": {
        "format-wifi": "\uf1eb  {essid}",
        "format-ethernet": "󰈀 cabo",
        "format-disconnected": "󰖪 sem rede",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "on-click": "nm-connection-editor"
    },

    // Folha = modo economia de bateria. Verde = ligado. Clique liga/desliga.
    // "signal": o script avisa a barra na hora (pkill -RTMIN+8 waybar)
    "custom/economia": {
        "exec": "~/.config/hypr/scripts/modo-economia.sh status",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "~/.config/hypr/scripts/modo-economia.sh"
    },

    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "\uf1e6  {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}"
    },

    // Ícones de apps em segundo plano (Wi-Fi, Bluetooth, etc.)
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/energia": {
        "format": "\uf011",
        "tooltip-format": "Energia (Super + Esc)",
        "on-click": "~/.config/hypr/scripts/menu-energia.sh"
    }
}
