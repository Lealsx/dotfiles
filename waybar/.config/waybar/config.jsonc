// =============================================================
//  Waybar — a barra do topo
// =============================================================
//  Esquerda: menu do Arch, áreas de trabalho
//  Centro:   relógio (clique = calendário) + Spotify + outros players (YouTube...)
//  Direita:  bateria (só quando está baixa), gaveta com os ícones dos apps
//            e o botão da Central de controle (volume, brilho, Wi-Fi,
//            Bluetooth, economia, telas, teclado, energia e notificações)
//  Doc: https://github.com/Alexays/Waybar/wiki
// =============================================================
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 6,

    "modules-left":   ["custom/menu", "hyprland/workspaces"],
    "modules-center": ["clock", "group/spotify", "custom/player"],
    "modules-right":  ["battery", "group/bandeja", "custom/central"],

    // Botão que abre o menu de aplicativos
    "custom/menu": {
        "format": "\uf303",
        "tooltip-format": "Aplicativos (Super + D)",
        "on-click": "rofi -show drun"
    },

    // Áreas de trabalho: número + ícone de cada app aberto nela.
    // Clique para ir, rolar para passar.
    // "window-rewrite": qual ícone usar para cada app (pela "class" da janela,
    // que dá para ver com: hyprctl clients). Os ícones são da fonte Nerd Font.
    "hyprland/workspaces": {
        "format": "{id} {windows}",
        "format-window-separator": " ",
        "window-rewrite-default": "\uf059",
        "window-rewrite": {
            "class<kitty>": "\uf120",
            "class<[Cc]ode.*>": "\ue70c",
            "class<jetbrains-.*>": "\ue7b5",
            "class<.*brave.*>": "\uf268",
            "class<[Ss]potify>": "\uf1bc",
            "class<org.gnome.Nautilus>": "\uf07b",
            "class<org.gnome.Papers>": "\uf1c1",
            "class<org.gnome.Loupe>": "\uf03e",
            "class<org.gnome.Showtime>": "\uf03d",
            "class<org.gnome.Calculator>": "\uf1ec",
            "class<org.pulseaudio.pavucontrol>": "\uf028",
            "class<blueman-manager>": "\uf293",
            "class<nm-connection-editor>": "\uf1eb",
            "class<org.gnome.TextEditor>": "\uf044",
            "class<org.gnome.SystemMonitor>": "\uf080"
        },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    "clock": {
        "locale": "pt_BR.UTF-8",
        "format": "{:%H:%M}",
        "format-alt": "{:L%A, %d de %B  %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#e3123b'><b>{}</b></span>",
                "today":  "<span color='#ff7b5c'><b><u>{}</u></b></span>"
            }
        }
    },

    // ---------- Spotify ----------
    // Um "grupo" junta vários módulos numa pílula só:
    // [ícone + música] [anterior] [tocar/pausar] [próxima]
    "group/spotify": {
        "orientation": "horizontal",
        "modules": ["custom/spotify", "custom/visualizador", "custom/spotify-anterior", "custom/spotify-play", "custom/spotify-proxima"]
    },

    // Música atual. Clique = abrir/mostrar o Spotify | rolar = próxima/anterior
    "custom/spotify": {
        "exec": "~/.config/hypr/scripts/spotify.sh status",
        "return-type": "json",
        "format": "\uf1bc {}",
        "on-click": "~/.config/hypr/scripts/spotify.sh abrir",
        "on-scroll-up": "playerctl --player=spotify next",
        "on-scroll-down": "playerctl --player=spotify previous",
        "escape": false
    },
    // Barrinhas que dançam no ritmo da música (cava). Sem som, ficam paradas no chão (▁▁▁).
    "custom/visualizador": {
        "exec": "~/.config/hypr/scripts/visualizador.sh",
        "format": "{}",
        "tooltip": false
    },
    "custom/spotify-anterior": {
        "format": "\uf048",
        "tooltip-format": "Música anterior",
        "on-click": "playerctl --player=spotify previous"
    },
    "custom/spotify-play": {
        "format": "\uf04b \uf04c",
        "tooltip-format": "Tocar/pausar",
        "on-click": "playerctl --player=spotify play-pause"
    },
    "custom/spotify-proxima": {
        "format": "\uf051",
        "tooltip-format": "Próxima música",
        "on-click": "playerctl --player=spotify next"
    },

    // Música/vídeo tocando FORA do Spotify (YouTube no Brave, VLC...)
    // Só aparece quando tem algo tocando ou pausado.
    // Clique = tocar/pausar | botão direito = próxima | rolar = próxima/anterior
    "custom/player": {
        "exec": "~/.config/hypr/scripts/player.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "playerctl --ignore-player=spotify play-pause",
        "on-click-right": "playerctl --ignore-player=spotify next",
        "on-scroll-up": "playerctl --ignore-player=spotify next",
        "on-scroll-down": "playerctl --ignore-player=spotify previous",
        "escape": false
    },

    // Bateria: só aparece quando está baixa (25% ou menos) e fora da tomada.
    // No resto do tempo o formato é vazio e o módulo some (veja na Central).
    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "",
        "format-warning": "{icon} {capacity}%",
        "format-critical": "{icon} {capacity}%",
        "format-charging": "",
        "format-plugged": "",
        "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}"
    },

    // Gaveta: a setinha abre/fecha os ícones dos apps em segundo plano
    // (Spotify, Wi-Fi, Bluetooth...) — recurso "drawer" da própria Waybar
    "group/bandeja": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 400,
            "children-class": "item-bandeja",
            "click-to-reveal": true,
            "transition-left-to-right": false
        },
        "modules": ["custom/seta", "tray"]
    },
    "custom/seta": {
        "format": "\uf053",
        "tooltip-format": "Apps em segundo plano (clique para mostrar)"
    },

    // Botão da Central de controle (SwayNC): clique abre/fecha o painel;
    // botão direito liga/desliga o "não perturbe". O ícone mostra se há
    // notificações novas e se o "não perturbe" está ligado.
    "custom/central": {
        "exec": "swaync-client -swb",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "notification": "\uf1de<span foreground='#ff7b5c'><sup> ●</sup></span>",
            "none": "\uf1de",
            "dnd-notification": "\uf1f6<span foreground='#ff7b5c'><sup> ●</sup></span>",
            "dnd-none": "\uf1f6",
            "inhibited-notification": "\uf1de<span foreground='#ff7b5c'><sup> ●</sup></span>",
            "inhibited-none": "\uf1de",
            "dnd-inhibited-notification": "\uf1f6<span foreground='#ff7b5c'><sup> ●</sup></span>",
            "dnd-inhibited-none": "\uf1f6"
        },
        "tooltip-format": "Central de controle (Super + N)",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    // Ícones de apps em segundo plano (dentro da gaveta acima)
    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
