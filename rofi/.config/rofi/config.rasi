/* =============================================================
   Rofi — menu de aplicativos (Super + D)
   Digite para buscar, Enter para abrir, Esc para fechar.
   ============================================================= */

/* Cores: as do álbum tocando (cores.rasi) ou as do Muzan (cores-muzan.rasi) */
@import "cores.rasi"

configuration {
    modi: "drun,window,run";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "Apps";
    display-window: "Janelas";
    display-run: "Comandos";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 12";
}

* {
    background-color: transparent;
    text-color: @texto;
}

window {
    width: 600px;
    background-color: @fundo;
    border: 2px;
    border-color: @destaque;
    border-radius: 14px;
}

mainbox  { padding: 14px; spacing: 10px; }

inputbar {
    background-color: @fundo2;
    border-radius: 10px;
    padding: 10px 14px;
    spacing: 10px;
    children: [ prompt, entry ];
}
prompt   { text-color: @destaque; }
entry    { placeholder: "Buscar..."; placeholder-color: @apagado; }

listview { lines: 8; columns: 1; spacing: 4px; scrollbar: false; }

element  { padding: 8px 12px; border-radius: 8px; spacing: 12px; }
/* Itens não selecionados: fundo transparente (o Rofi novo pinta de claro por padrão) */
element normal.normal, element alternate.normal, element normal.active,
element alternate.active, element normal.urgent, element alternate.urgent {
    background-color: transparent;
    text-color: @texto;
}
element selected.active, element selected.urgent { background-color: @destaque; text-color: @sobre-destaque; }
element selected.normal { background-color: @destaque; text-color: @sobre-destaque; }
element-icon { size: 24px; }
element-text { text-color: inherit; vertical-align: 0.5; }
